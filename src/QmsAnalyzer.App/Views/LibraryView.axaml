<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QmsAnalyzer.App.Views.LibraryView">
  <Border Classes="card" Padding="0">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="h2" Text="문서 라이브러리" VerticalAlignment="Center"/>
            <TextBlock Classes="dim" Text="{Binding Library.Summary}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <ComboBox Width="130" ItemsSource="{Binding Library.TypeFilters}"
                      SelectedItem="{Binding Library.SelectedType}"/>
            <TextBox Width="240" Watermark="문서번호·이름 검색…"
                     Text="{Binding Library.SearchText}"/>
          </StackPanel>
          <Panel/>
        </DockPanel>
      </Border>
      <DataGrid ItemsSource="{Binding Library.Rows}"
                IsReadOnly="True" AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="문서번호" Binding="{Binding Id}" Width="130"/>
          <DataGridTextColumn Header="문서명" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="구분" Binding="{Binding TypeLabel}" Width="100"/>
          <DataGridTextColumn Header="Rev" Binding="{Binding Rev}" Width="60"/>
          <DataGridTextColumn Header="적용일" Binding="{Binding Effective}" Width="110"/>
          <DataGridTextColumn Header="관리부서" Binding="{Binding Dept}" Width="120"/>
          <DataGridTextColumn Header="기록" Binding="{Binding RecordCount}" Width="70"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Border>
</UserControl>
