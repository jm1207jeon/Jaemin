<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QmsWeaver.App.Views.DrillDownView">
  <Border Classes="card" Padding="0">
    <DockPanel>
      <Border DockPanel.Dock="Top" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="⚙ 폴더 연결하러 가기" FontSize="12"
                  IsVisible="{Binding Drill.NoRecords}"
                  Command="{Binding Drill.GoSettingsCommand}"/>
          <TextBlock Text="{Binding Drill.Breadcrumb}" Foreground="{DynamicResource Ink2Brush}"
                     FontSize="12.5" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Grid ColumnDefinitions="230,1,190,1,170,1,*">
        <!-- 1열: 절차서 -->
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Classes="sect" Text="절차서" Margin="12,10,0,4"/>
          <ListBox ItemsSource="{Binding Drill.Procedures}"
                   SelectedItem="{Binding Drill.SelectedProcedure}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
        <!-- 2열: 그룹 -->
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Classes="sect" Text="그룹" Margin="12,10,0,4"/>
          <ListBox ItemsSource="{Binding Drill.Groups}"
                   SelectedItem="{Binding Drill.SelectedGroup}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="3" Background="{DynamicResource BorderBrush}"/>
        <!-- 3열: 실행 단위 -->
        <DockPanel Grid.Column="4">
          <TextBlock DockPanel.Dock="Top" Classes="sect" Text="실행 단위" Margin="12,10,0,4"/>
          <ListBox ItemsSource="{Binding Drill.Units}"
                   SelectedItem="{Binding Drill.SelectedUnit}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="5" Background="{DynamicResource BorderBrush}"/>
        <!-- 4열: 기록 테이블 -->
        <DockPanel Grid.Column="6">
          <Border DockPanel.Dock="Top" Padding="12,10,12,4">
            <DockPanel>
              <TextBlock Classes="sect" Text="기록 (더블클릭 = 역추적·검토 열기)" Margin="0"/>
            </DockPanel>
          </Border>
          <DataGrid x:Name="RecordsGrid"
                    ItemsSource="{Binding Drill.Records}"
                    SelectedItem="{Binding Drill.SelectedRecord}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal"
                    Background="{DynamicResource Surface2Brush}"
                    BorderThickness="0"
                    DoubleTapped="OnRecordDoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="문서" Binding="{Binding Title}" Width="*" MinWidth="180"/>
              <DataGridTextColumn Header="Rev" Binding="{Binding Rev}" Width="55"/>
              <DataGridTextColumn Header="수행/작성일" Binding="{Binding Date}" Width="105"/>
              <DataGridTextColumn Header="작성" Binding="{Binding Author}" Width="70"/>
              <DataGridTextColumn Header="검토" Binding="{Binding Reviewer}" Width="70"/>
              <DataGridTextColumn Header="승인" Binding="{Binding Approver}" Width="70"/>
              <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
